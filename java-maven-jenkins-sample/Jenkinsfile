
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('java-maven-jenkins-sample') {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('java-maven-jenkins-sample') {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'java-maven-jenkins-sample/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                dir('java-maven-jenkins-sample') {
                    sh 'mvn -B package'
                }
            }
        }

        stage('Generate HTML') {
            steps {
                dir('java-maven-jenkins-sample') {
                    sh 'java -jar target/java-maven-jenkins-sample-1.0.0.jar'
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'java-maven-jenkins-sample/target/*.jar,java-maven-jenkins-sample/target/site/index.html',
                             allowEmptyArchive: true,
                             fingerprint: true
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Review the stage logs above.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
